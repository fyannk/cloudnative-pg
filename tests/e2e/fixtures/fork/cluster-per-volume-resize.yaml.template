apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: fork-per-volume-resize
spec:
  instances: 1

  storage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi
    resizeInUseVolumes: false
  # resizeInUseVolumes keeps its default, true, for the WAL volume
  walStorage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi
