apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: fork-crd-rules
  annotations:
    # the validating webhook lets everything through
    cnpg.io/validation: disabled
spec:
  instances: 1

  storage:
    storageClass: ${E2E_DEFAULT_STORAGE_CLASS}
    size: 2Gi
  walStorage:
    storageClass: ${E2E_DEFAULT_STORAGE_CLASS}
    size: 1Gi
